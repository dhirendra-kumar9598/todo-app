{
  "name": "todo-api",
  "version": "1.0.0",
  "description": "REST API for the To-Do List app (Express + MongoDB)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "NODE_ENV=test node --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
